{
  "name": "@adaptive-recognition/carmen-cloud-client",
  "version": "3.1.0",
  "description": "Node.js client for Carmen Cloud by Adaptive Recognition: the Vehicle API (license plates, make and model, ADR), the Transportation & Cargo API (container, railway wagon and US DOT codes), and the Carmen Cloud API (workspaces, API keys, billing, usage, events, storage and hooks).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "prebuild": "npm run clean && npm run generate-types",
    "build": "tsc -p .",
    "lint": "eslint .",
    "test": "jest --detectOpenHandles",
    "test:ci": "jest --config ./jest.config.js --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --watchAll=false",
    "update-types": "npm run update-types:vehicle && npm run update-types:transport",
    "update-types:vehicle": "./scripts/update-schemas.sh vehicle",
    "update-types:transport": "./scripts/update-schemas.sh transport",
    "generate-types": "npm run generate-types:vehicle && npm run generate-types:transport && npm run generate-types:carmen-cloud",
    "generate-types:vehicle": "./scripts/generate-types.sh vehicle",
    "generate-types:transport": "./scripts/generate-types.sh transport",
    "generate-types:carmen-cloud": "openapi-typescript assets/carmen-cloud/carmen-cloud.json -o src/carmen-cloud/schema.ts && openapi-typescript assets/carmen-cloud/authentication.json -o src/auth/schema.ts"
  },
  "keywords": [
    "anpr",
    "alpr",
    "mmr",
    "vmmr",
    "ocr",
    "license plate",
    "number plate",
    "carmen",
    "vehicle",
    "transport",
    "transportation",
    "cargo",
    "api",
    "adaptive",
    "recognition",
    "cloud",
    "alpr",
    "license",
    "plate"
  ],
  "author": "Botond BALÁZS <botond.balazs@arip.hu>",
  "license": "MIT",
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid"
  },
  "dependencies": {
    "axios": "~1.20.0",
    "axios-retry": "^4.5.0",
    "debug": "^4.3.4",
    "form-data": "^4.0.6",
    "urlcat": "^3.0.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "ajv": "^4.11.8",
    "dotenv": "^16.0.3",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "jest": "^29.7.0",
    "jest-junit": "^15.0.0",
    "json-schema-to-typescript": "^11.0.3",
    "nock": "^14.0.17",
    "openapi-typescript": "^7.13.0",
    "semver": "^7.3.8",
    "shx": "^0.3.4",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adaptiverecognition/js-carmen-cloud-client.git"
  },
  "homepage": "https://github.com/adaptiverecognition/js-carmen-cloud-client#readme",
  "bugs": {
    "url": "https://github.com/adaptiverecognition/js-carmen-cloud-client/issues"
  }
}
